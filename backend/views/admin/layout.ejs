<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Silk Shadow Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
body{background:#faf5f7!important;color:#38242d}.card{border-color:#ead7de;border-radius:12px;box-shadow:0 3px 14px #38242d06}.btn-primary{background:#9b4965;border-color:#9b4965}.btn-primary:hover{background:#803951;border-color:#803951}.btn-outline-primary{color:#9b4965;border-color:#9b4965}.btn-outline-primary:hover{background:#9b4965;border-color:#9b4965}a{color:#87425a}.navbar{background:#38242d!important}.table>:not(caption)>*>*{padding:14px}.form-control:focus,.form-select:focus{border-color:#9b4965;box-shadow:0 0 0 .2rem #ead7de}
</style></head>
<body class="bg-light">

<% if (typeof adminName !== 'undefined' && adminName) { %>
<nav class="navbar navbar-dark bg-dark mb-4">
  <div class="container">
    <a class="navbar-brand" href="/admin/products">Silk Shadow Admin</a>
    <div class="d-flex align-items-center gap-3">
      <a class="text-white" href="/admin/orders">Orders</a>
      <span class="text-white-50 small"><%= adminName %></span>
      <form action="/admin/logout" method="POST" class="m-0">
        <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
      </form>
    </div>
  </div>
</nav>
<% } %>

<div class="container pb-5">
  <%- body %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
