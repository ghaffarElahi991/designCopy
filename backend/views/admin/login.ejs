<div class="row justify-content-center mt-5">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h4 class="card-title mb-1">Admin Login</h4>
        <p class="text-muted small">Manage your products</p>

        <% if (error) { %>
          <div class="alert alert-danger py-2"><%= error %></div>
        <% } %>

        <form method="POST" action="/admin/login" class="mt-3">
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="admin@luxefashion.com" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" name="password" class="form-control" required>
          </div>
          <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>
      </div>
    </div>
  </div>
</div>
